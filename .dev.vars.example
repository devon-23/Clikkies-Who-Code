# Worker secrets for LOCAL development. Copy to .dev.vars (gitignored).
# Deployed environments never read this file -- see docs/environment.md.

# SECRET. Postgres connection string for your *dev* Supabase project.
# Supabase dashboard -> Connect -> "Transaction pooler" (port 6543).
# Leave blank and the app still runs; anything needing the database returns 503.
DATABASE_URL=

# Not secret. Your dev Supabase project URL, e.g. https://abcd1234.supabase.co
# The API uses it to fetch the public keys that verify sign-in tokens.
SUPABASE_URL=
