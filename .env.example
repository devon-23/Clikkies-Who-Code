# Browser configuration. Copy to .env (gitignored).
#
# Everything prefixed VITE_ is compiled into the JavaScript the browser
# downloads, so NOTHING secret may ever go here. These two values are public
# by design: the publishable key only lets a browser talk to Supabase Auth,
# and the database refuses every direct request from it (row-level security).

# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
